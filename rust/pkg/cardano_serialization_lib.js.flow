  /**
   * @returns {number}
   */
  full_size(): number;

  /**
   * !!! DEPRECATED !!!
   * Can emit error if add a cert with script credential.
   * Use set_certs_builder instead.
   * @param {Certificates} certs
   */
  set_certs(certs: Certificates): void;
}
